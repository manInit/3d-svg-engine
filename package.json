{
  "name": "3d-svg-engine",
  "version": "0.1.0",
  "description": "lightweight 3d engine based on SVG",
  "keywords": [
    "3d",
    "engine",
    "svg"
  ],
  "homepage": "https://github.com/manInit/3d-svg-engine",
  "license": "MIT",
  "author": "Denis Bronnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manInit/3d-svg-engine"
  },
  "files": [
    "dist/3dengine.dist.js",
    "README.md"
  ],
  "type": "module",
  "main": "dist/3dengine.dist.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1"
}
